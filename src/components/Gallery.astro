---
/**
 * Galeria em carrossel — "montagem por ripas".
 * A foto seguinte entra em três ripas horizontais (as mesmas três ripas da
 * logo), que deslizam uma após a outra e se encaixam sobre a foto atual.
 * Uma régua com uma marca por foto mede a posição na sequência.
 * Sem JavaScript: a primeira foto aparece e as miniaturas abrem cada foto.
 */
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
import { gallery } from '../content/media';
import { galleryIntro } from '../content/sections';
import { asset } from '../lib/paths';

const total = gallery.length;
const pad = (n: number) => String(n).padStart(2, '0');
const photo = (slug: string, size: '960' | '1600' | 'thumb') => asset(`/fotos/galeria/${slug}-${size}.webp`);
const srcset = (slug: string) => `${photo(slug, '960')} 960w, ${photo(slug, '1600')} 1600w`;
const sizes = '(min-width: 64em) 66vw, calc(100vw - 2rem)';
const first = gallery[0];
---

<section class="section surface-dark gallery" id="galeria" aria-labelledby="galeria-title">
  <div class="container">
    <SectionHead
      index={galleryIntro.index}
      label={galleryIntro.label}
      title={galleryIntro.title}
      text={galleryIntro.text}
      titleId="galeria-title"
      meta={`Fig. 05 — ${total} registros`}
    />

    <div
      class="gallery__viewer"
      data-gallery
      data-sizes={sizes}
      role="region"
      aria-roledescription="carrossel"
      aria-label="Fotos da produção"
      tabindex="-1"
    >
      <div class="gallery__stage" data-gallery-stage>
        <img
          class="gallery__base"
          data-gallery-base
          src={photo(first.slug, '1600')}
          srcset={srcset(first.slug)}
          sizes={sizes}
          width="1600"
          height="1000"
          alt={first.alt}
          loading="lazy"
          decoding="async"
          style={`--fy:${first.focus * 100}%`}
        />
        <div class="gallery__slats" data-gallery-slats aria-hidden="true"></div>
        <span class="crop-marks" aria-hidden="true"></span>
        <p class="gallery__tag t-label" aria-hidden="true">
          <span data-gallery-code>F—{pad(1)}</span> · <span data-gallery-stage-name>{first.stage}</span>
        </p>
      </div>

      <div class="gallery__panel">
        <p class="gallery__count t-mono" aria-hidden="true">
          <span class="gallery__current" data-gallery-current>{pad(1)}</span>
          <span class="gallery__total">/ {pad(total)}</span>
        </p>

        <div class="gallery__ruler" aria-hidden="true" style={`--n:${total}`}>
          <span class="gallery__ticks"></span>
          <span class="gallery__fill" data-gallery-fill></span>
        </div>

        <p class="gallery__caption" data-gallery-caption aria-live="polite">
          <span class="visually-hidden">Foto 1 de {total}. </span>{first.alt}.
        </p>

        <div class="gallery__controls">
          <button class="gallery__btn" type="button" data-gallery-prev aria-label="Foto anterior">
            <Icon name="arrow-right" class="gallery__arrow gallery__arrow--prev" />
          </button>
          <button class="gallery__btn" type="button" data-gallery-next aria-label="Próxima foto">
            <Icon name="arrow-right" class="gallery__arrow" />
          </button>
        </div>
      </div>

      <ul class="gallery__thumbs" role="list" data-gallery-thumbs>
        {
          gallery.map((item, i) => (
            <li>
              <a
                class="gallery__thumb"
                href={photo(item.slug, '1600')}
                data-gallery-thumb={i}
                data-slug={item.slug}
                data-stage={item.stage}
                data-alt={item.alt}
                data-focus={item.focus}
                aria-current={i === 0 ? 'true' : undefined}
              >
                <img src={photo(item.slug, 'thumb')} width="320" height="240" alt="" loading="lazy" decoding="async" />
                <span class="visually-hidden">
                  Ver foto {i + 1}: {item.alt}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .gallery__viewer {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: minmax(0, 1fr);
    outline: none;
  }

  /* — Palco — */
  .gallery__stage {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--sb-charcoal-deep);
    touch-action: pan-y;
    user-select: none;
  }

  /* As ripas são criadas pelo script, por isso as regras delas são :global(). */
  .gallery__base,
  .gallery__slats :global(.gallery__slat img) {
    position: absolute;
    left: 0;
    width: 100%;
    object-fit: cover;
    object-position: 50% var(--fy, 50%);
  }

  .gallery__base {
    top: 0;
    height: 100%;
  }

  /* Cada ripa mostra uma faixa da foto inteira: a imagem ocupa o palco todo e é deslocada. */
  .gallery__slats {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .gallery__slats :global(.gallery__slat) {
    position: absolute;
    left: 0;
    width: 100%;
    height: calc(100% / 3);
    top: calc(var(--k) * 100% / 3);
    overflow: hidden;
  }

  .gallery__slats :global(.gallery__slat img) {
    top: calc(var(--k) * -100%);
    height: 300%;
  }

  /* Junta entre as ripas: aparece durante a montagem e some quando ela fecha. */
  .gallery__slats :global(.gallery__slat::after) {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 3px;
    background: var(--sb-charcoal-deep);
    opacity: var(--seam, 0);
  }

  .gallery__stage .crop-marks {
    z-index: 3;
  }

  .gallery__tag {
    position: absolute;
    z-index: 3;
    left: 0;
    bottom: 0;
    margin: 0;
    padding: 0.55rem 0.8rem;
    background: rgb(38 29 24 / 0.82);
    color: var(--sb-beige);
  }

  /* — Painel — */
  .gallery__panel {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .gallery__count {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;
    line-height: 1;
  }

  .gallery__current {
    font-size: clamp(2.5rem, 2rem + 2vw, 4rem);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .gallery__total {
    color: var(--fg-muted);
    font-size: 1rem;
  }

  /* Régua: uma marca por foto; o preenchimento mede o avanço. */
  .gallery__ruler {
    position: relative;
    height: 14px;
    color: var(--line-strong);
  }

  .gallery__ticks {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(currentColor, currentColor) 0 100% / 100% 1px no-repeat,
      repeating-linear-gradient(
          to right,
          currentColor 0 1px,
          transparent 1px calc((100% - 1px) / (var(--n) - 1))
        )
        0 0 / 100% 70% no-repeat;
  }

  .gallery__fill {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: var(--sb-almond);
    transform-origin: left center;
    transform: scaleX(var(--progress, 0));
    transition: transform 720ms var(--ease-out);
  }

  .gallery__caption {
    min-height: 3.2em;
    max-width: 30rem;
    margin: 0;
    color: var(--fg);
  }

  .gallery__controls {
    display: flex;
    gap: var(--space-3);
  }

  .gallery__btn {
    display: inline-grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: transparent;
    color: var(--fg);
    transition:
      background-color var(--dur-base) var(--ease-standard),
      color var(--dur-base) var(--ease-standard),
      border-color var(--dur-base) var(--ease-standard);
  }

  .gallery__btn:hover {
    background: var(--sb-beige);
    border-color: var(--sb-beige);
    color: var(--sb-charcoal);
  }

  .gallery__btn :global(.gallery__arrow) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .gallery__btn :global(.gallery__arrow--prev) {
    transform: scaleX(-1);
  }

  /* — Miniaturas — */
  .gallery__thumbs {
    display: flex;
    gap: 0.5rem;
    margin: 0;
    padding: 0 0 0.5rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--line-strong) transparent;
  }

  .gallery__thumb {
    position: relative;
    display: block;
    flex: none;
    width: 5.5rem;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    outline-offset: -2px;
  }

  .gallery__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.5;
    filter: saturate(0.6);
    transition:
      opacity var(--dur-base) var(--ease-standard),
      filter var(--dur-base) var(--ease-standard);
  }

  .gallery__thumb:hover img,
  .gallery__thumb[aria-current='true'] img {
    opacity: 1;
    filter: none;
  }

  /* Foto ativa: régua de medida sob a miniatura. */
  .gallery__thumb::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 3px;
    background: var(--sb-almond);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .gallery__thumb[aria-current='true']::after {
    transform: scaleX(1);
  }

  @media (min-width: 48em) {
    .gallery__stage {
      aspect-ratio: 16 / 10;
    }

    .gallery__thumb {
      width: 7rem;
    }
  }

  @media (min-width: 64em) {
    .gallery__viewer {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--col-gap);
      row-gap: var(--space-5);
    }

    .gallery__stage {
      grid-column: 1 / span 8;
    }

    .gallery__panel {
      grid-column: 9 / span 4;
      align-self: end;
      gap: var(--space-5);
    }

    .gallery__thumbs {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  import { initGallery } from '../scripts/gallery';
  initGallery();
</script>
